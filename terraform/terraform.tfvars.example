# Copie este arquivo para terraform.tfvars e preencha os valores
# cp terraform.tfvars.example terraform.tfvars

region       = "us-east-1"
az_a         = "us-east-1a"
az_b         = "us-east-1b"

# Nome do Key Pair criado no console AWS (EC2 > Key Pairs)
key_name = "vockey"

# Seu IP publico para SSH (descubra com: curl ifconfig.me)
my_ip = "SEU_IP/32"

instance_type = "t3.medium"

# Seu usuario do Docker Hub (ex: "guisteinn")
dockerhub_username = "SEU_USUARIO_DOCKERHUB"

# Instance profile do Academy (geralmente ja existe)
lab_instance_profile = "LabInstanceProfile"
